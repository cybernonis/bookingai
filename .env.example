# ── Server ──────────────────────────────────────────────────��─────────────────
PORT=3000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Local default: bookings.db in project root
# Railway: mount a Volume at /data and set DB_PATH=/data/bookings.db
DB_PATH=

# ── Session ───────────────────────────────────────────────────────────────────
# IMPORTANT: change this to a long random string in production
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-in-production

# ── Super-admin (optional) ────────────────────────────────────────────────────
# Grants access to all businesses in the admin dashboard
# If not set, only per-business admins created via /setup can log in
ADMIN_USER=
ADMIN_PASS=

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Maps (optional) ───────────────────────────────────────────────────────────
# Enables real road-distance calculation via Google Maps Distance Matrix API
# If not set, falls back to straight-line distance via Nominatim (OpenStreetMap)
GOOGLE_MAPS_API_KEY=

# ── Email / Gmail SMTP (optional) ────────────────────────────────────────────
# Use a Gmail account + App Password (requires 2FA enabled on Google account)
# Create App Password: myaccount.google.com/apppasswords → "Other" → copy 16-char code
EMAIL_USER=you@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
