# ── Server ──────────────────────────────────────────────────��─────────────────
PORT=3000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Local default: bookings.db in project root
# Railway: mount a Volume at /data and set DB_PATH=/data/bookings.db
DB_PATH=

# ── Session ───────────────────────────────────────────────────────────────────
# IMPORTANT: change this to a long random string in production
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-in-production

# ── Super-admin (optional) ────────────────────────────────────────────────────
# Grants access to all businesses in the admin dashboard
# If not set, only per-business admins created via /setup can log in
ADMIN_USER=
ADMIN_PASS=

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Maps & Distance (optional) ────────────────────────────────────────────────
# Google Maps API key — enables two features:
#   1. Places Autocomplete in chat widget (as customer types pickup/destination)
#   2. Road distance calculation fallback (Distance Matrix API)
# Get a free key: console.cloud.google.com → enable "Places API" + "Distance Matrix API"
GOOGLE_MAPS_API_KEY=

# OpenRouteService API key — preferred provider for real road distance + duration
# Free tier: 2000 requests/day. Get a key at: openrouteservice.org
# If not set, falls back to Google Maps Distance Matrix, then Nominatim (straight-line)
ORS_API_KEY=

# ── Email / Gmail SMTP (optional) ────────────────────────────────────────────
# Use a Gmail account + App Password (requires 2FA enabled on Google account)
# Create App Password: myaccount.google.com/apppasswords → "Other" → copy 16-char code
EMAIL_USER=you@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# ── SMS / Twilio (optional) ───────────────────────────────────────────────────
# Sign up at twilio.com → get Account SID + Auth Token from the Console dashboard
# Buy a phone number (From Number) that supports SMS
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM=+1xxxxxxxxxx
